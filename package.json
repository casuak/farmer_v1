{
  "name": "pinebrook-voxel-farm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test:world": "esbuild scripts/verify-world.ts --bundle --platform=node --format=esm --outfile=.cache/verify-world.mjs && node .cache/verify-world.mjs",
    "test:color-grading": "esbuild scripts/verify-color-grading.ts --bundle --platform=node --format=esm --outfile=.cache/verify-color-grading.mjs && node .cache/verify-color-grading.mjs",
    "test:color-grading:browser": "node scripts/verify-color-grading-browser.mjs",
    "test:time-rate:browser": "node scripts/verify-time-rate-browser.mjs",
    "test:fishing": "esbuild scripts/verify-fishing.ts --bundle --platform=node --format=esm --outfile=.cache/verify-fishing.mjs && node .cache/verify-fishing.mjs",
    "test:fishing:browser": "node scripts/verify-fishing-browser.mjs",
    "test:mining": "esbuild scripts/verify-mining.ts --bundle --platform=node --format=esm --outfile=.cache/verify-mining.mjs && node .cache/verify-mining.mjs",
    "test:mining:browser": "node scripts/verify-mining-browser.mjs",
    "test:mining:per-hit": "esbuild scripts/verify-mining-per-hit.ts --bundle --platform=node --format=esm --outfile=.cache/verify-mining-per-hit.mjs && node .cache/verify-mining-per-hit.mjs",
    "test:mining:per-hit:browser": "node scripts/verify-mining-per-hit-browser.mjs",
    "test:mining:hold": "esbuild scripts/verify-mining-hold.ts --bundle --platform=node --format=esm --outfile=.cache/verify-mining-hold.mjs && node .cache/verify-mining-hold.mjs && esbuild scripts/verify-ground-drops.ts --bundle --platform=node --format=esm --outfile=.cache/verify-ground-drops.mjs && node .cache/verify-ground-drops.mjs",
    "test:dialogue": "esbuild scripts/verify-dialogue.ts --bundle --platform=node --format=esm --outfile=.cache/verify-dialogue.mjs && node .cache/verify-dialogue.mjs",
    "test:dialogue:audio": "esbuild scripts/verify-dialogue-audio.ts --bundle --platform=node --format=esm --outfile=.cache/verify-dialogue-audio.mjs && node .cache/verify-dialogue-audio.mjs",
    "test:dialogue:browser": "node scripts/verify-dialogue-browser.mjs",
    "test:music": "esbuild scripts/verify-music.ts --bundle --platform=node --format=esm --outfile=.cache/verify-music.mjs && node .cache/verify-music.mjs",
    "test:music:browser": "node scripts/verify-music-browser.mjs",
    "test:beach-boss": "esbuild scripts/verify-beach-boss.ts --bundle --platform=node --format=esm --outfile=.cache/verify-beach-boss.mjs && node .cache/verify-beach-boss.mjs && esbuild scripts/verify-beach-boss-view.ts --bundle --platform=node --format=esm --outfile=.cache/verify-beach-boss-view.mjs && node .cache/verify-beach-boss-view.mjs",
    "test:beach-boss:browser": "node scripts/verify-beach-boss-browser.mjs",
    "test:pickups": "esbuild scripts/verify-pickups.ts --bundle --platform=node --format=esm --outfile=.cache/verify-pickups.mjs && node .cache/verify-pickups.mjs",
    "test:pickups:browser": "node scripts/verify-pickups-browser.mjs",
    "test:inventory-drops": "esbuild scripts/verify-inventory-drops.ts --bundle --platform=node --format=esm --outfile=.cache/verify-inventory-drops.mjs && node .cache/verify-inventory-drops.mjs",
    "test:inventory-drops:browser": "node scripts/verify-inventory-drops-browser.mjs",
    "test:flashlight": "esbuild scripts/verify-flashlight.ts --bundle --platform=node --format=esm --outfile=.cache/verify-flashlight.mjs && node .cache/verify-flashlight.mjs",
    "test:flashlight:switch": "esbuild scripts/verify-flashlight-switch.ts --bundle --platform=node --format=esm --outfile=.cache/verify-flashlight-switch.mjs && node .cache/verify-flashlight-switch.mjs",
    "test:flashlight:switch:browser": "node scripts/verify-flashlight-switch-browser.mjs",
    "test:flashlight:browser": "node scripts/verify-flashlight-browser.mjs",
    "test:wall-corners": "esbuild scripts/verify-wall-corners.ts --bundle --platform=node --format=esm --outfile=.cache/verify-wall-corners.mjs && node .cache/verify-wall-corners.mjs",
    "test:wall-corners:browser": "node scripts/verify-wall-corners-browser.mjs http://127.0.0.1:5177 after",
    "test:item-sprites": "esbuild scripts/verify-item-sprites.ts --bundle --platform=node --format=esm --external:sharp --outfile=.cache/verify-item-sprites.mjs && node .cache/verify-item-sprites.mjs",
    "test:sword": "esbuild scripts/verify-sword.ts --bundle --platform=node --format=esm --outfile=.cache/verify-sword.mjs && node .cache/verify-sword.mjs",
    "test:sword:browser": "node scripts/verify-sword-browser.mjs",
    "test:dodge": "esbuild scripts/verify-dodge.ts --bundle --platform=node --format=esm --outfile=.cache/verify-dodge.mjs && node .cache/verify-dodge.mjs",
    "test:dodge:browser": "node scripts/verify-dodge-browser.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.14.0",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
